[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_10="Left Hand"
3d_physics/layer_11="Right Hand"
3d_physics/layer_12="Head"

[physics]

common/physics_ticks_per_second=144
3d/physics_engine="Jolt Physics"
3d/default_gravity=2.08165e-12

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2

[xr]

openxr/enabled=true
openxr/default_action_map="res://addons/xr-kit/physics-movement/openxr_action_map.tres"
openxr/extensions/hand_tracking=true
openxr/extensions/hand_tracking_unobstructed_data_source=true
openxr/extensions/hand_tracking_controller_data_source=true
openxr/extensions/hand_interaction_profile=true
openxr/extensions/render_model=true
shaders/enabled=true
